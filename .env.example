# WorkMesh 环境变量示例
# 复制为 .env 后填写；应用启动时通过 python-dotenv 读取。

# ---- LLM（可选，用于「智能诊断」的推断润色）----
# 兼容 OpenAI 接口的服务均可：官方、Azure OpenAI 网关或自建代理。
OPENAI_API_KEY=
# 自建/代理服务填写接口地址，例如 https://api.example.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# ---- Elasticsearch（可选）----
# 也可以在页面表单里临时填写，不会写入磁盘。
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ---- Prometheus（可选）----
PROMETHEUS_BASE_URL=http://localhost:9090
PROMETHEUS_BEARER_TOKEN=
